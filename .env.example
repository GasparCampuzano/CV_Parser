# .env.example
# Plantilla de configuración para CV Processor
# Copiar este archivo como .env y completar con valores reales

# =============================
# AMBIENTE
# =============================
ENVIRONMENT=development  # development, staging, production
DEBUG=True  # True en desarrollo, False en producción

# =============================
# FLASK
# =============================
SECRET_KEY=dev-key-cambiar-en-produccion-usar-uuid-real
HOST=127.0.0.1
PORT=5000

# =============================
# AZURE OPENAI
# =============================
AZURE_OPENAI_ENDPOINT=https://tu-recurso.openai.azure.com/
AZURE_OPENAI_API_KEY=tu-api-key-aqui
AZURE_OPENAI_API_VERSION=2023-12-01-preview
DEPLOYMENT_NAME=gpt-35-turbo

# Configuración de procesamiento IA
MAX_TOKENS=4000
TEMPERATURE=0.1
AI_TIMEOUT=30
AI_MAX_RETRIES=3

# =============================
# MYSQL (pyodbc)
# =============================
# Conexión básica
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=cv_processor
MYSQL_PASSWORD=tu-password-segura
MYSQL_DATABASE=cv_database

# Driver ODBC (ajustar según tu sistema)
# Windows: MySQL ODBC 8.0 Unicode Driver
# Linux: MySQL ODBC 8.0 Unicode Driver (requiere instalación)
# MariaDB: MariaDB ODBC 3.0 Driver
ODBC_DRIVER="MySQL ODBC 8.0 Unicode Driver"

# Configuración avanzada de BD
DB_CHARSET=utf8mb4
DB_AUTOCOMMIT=False  # Usar transacciones
DB_POOL_SIZE=5  # Tamaño del pool de conexiones
DB_MAX_OVERFLOW=10  # Conexiones adicionales permitidas
DB_POOL_RECYCLE=3600  # Tiempo de reciclaje en segundos
DB_POOL_TIMEOUT=30  # Timeout para obtener conexión del pool
DB_ECHO=False  # True para ver queries SQL en logs (solo desarrollo)

# Timeouts y reintentos
DB_CONNECTION_TIMEOUT=30  # Timeout de conexión en segundos
DB_QUERY_TIMEOUT=60  # Timeout de queries en segundos
DB_MAX_RETRIES=3  # Reintentos de conexión
DB_RETRY_DELAY=2  # Delay entre reintentos en segundos

# =============================
# LOGGING
# =============================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# =============================
# PROCESAMIENTO
# =============================
# Archivos permitidos
EXTRACTION_TIMEOUT=60  # Timeout para extracción de texto

# OCR (opcional)
USE_OCR=False  # True si quieres usar OCR para PDFs escaneados
TESSERACT_PATH=/usr/bin/tesseract  # Path a Tesseract (ajustar según OS)
OCR_LANGUAGE=spa+eng  # Idiomas para OCR

# =============================
# VALIDACIÓN
# =============================
STRICT_VALIDATION=True  # Validación estricta de catálogos
AUTO_CREATE_AUXILIARS=False  # Crear automáticamente empresas/instituciones nuevas
FUZZY_MATCH_THRESHOLD=0.85  # Umbral para coincidencia difusa de nombres

# =============================
# PROCESAMIENTO BATCH
# =============================
BATCH_SIZE=10  # CVs por lote
BATCH_COMMIT_FREQUENCY=5  # Commit cada N registros
PARALLEL_PROCESSING=False  # Procesamiento paralelo
MAX_WORKERS=4  # Workers para procesamiento paralelo

# =============================
# NOTAS DE INSTALACIÓN
# =============================
# Para usar pyodbc con MySQL necesitas:
#
# 1. Instalar el driver ODBC de MySQL:
#    - Windows: Descargar desde https://dev.mysql.com/downloads/connector/odbc/
#    - Ubuntu/Debian: sudo apt-get install mysql-connector-odbc
#    - MacOS: brew install mysql-connector-odbc
#    - RHEL/CentOS: sudo yum install mysql-connector-odbc
#
# 2. Verificar drivers instalados:
#    - Windows: Panel de Control > Herramientas Administrativas > Orígenes de datos ODBC
#    - Linux/Mac: odbcinst -q -d
#
# 3. Instalar pyodbc:
#    pip install pyodbc
#
# 4. Si usas Linux/Mac, puede que necesites:
#    sudo apt-get install unixodbc-dev  # Debian/Ubuntu
#    brew install unixodbc  # MacOS
#
# 5. Verificar conexión:
#    python -c "from src.database import DatabaseConfig; DatabaseConfig().test_connection()"